# The e2e suite itself needs no env vars beyond what Playwright reads directly
# (E2E_BASE_URL, optional — defaults to http://localhost:81).
#
# What it DOES need is the stack to be up, which requires JWT_PRIVATE_KEY /
# JWT_PUBLIC_KEY in a .env file at the repo root (not this one) — generate it
# with:
#
#   make e2e-env
#
# or directly:
#
#   scripts/gen-jwt-keys.sh > .env

E2E_BASE_URL=http://localhost:81
